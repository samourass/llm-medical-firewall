# Copier ce fichier en .env puis adapter les valeurs.
LLM_PROVIDER=mock
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

VECTOR_DB=faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto (défaut) : essaie sentence_transformers, se rabat sur tfidf si le modèle ne peut pas être
# chargé (ex. pas d'accès réseau à huggingface.co). sentence_transformers | tfidf pour forcer.
EMBEDDING_PROVIDER=auto
RAG_CHUNK_SIZE_CHARS=500
RAG_CHUNK_OVERLAP_CHARS=80
RAG_TOP_K=3

# FIREWALL_MODEL par défaut = xgboost : DistilBERT n'a pas pu être entraîné dans les
# environnements de développement de ce projet (accès réseau à huggingface.co bloqué, voir
# docs/machine_learning.md) et n'est donc pas un choix par défaut sûr tant qu'il n'a pas été
# validé chez vous. IMPORTANT — ce n'est PAS le modèle le plus précis mesuré : sur le jeu de
# sécurité de 600 requêtes (docs/security_evaluation.md), logistic_regression obtient un
# f1_macro de 0,99 contre 0,80 pour xgboost. Si vous n'avez pas de contrainte particulière,
# essayez FIREWALL_MODEL=logistic_regression.
FIREWALL_MODEL=xgboost
FIREWALL_THRESHOLD=0.70

# Nombre de constatations distinctes en sortie au-delà duquel le firewall de sortie bloque toute
# la réponse plutôt que de caviarder les segments concernés.
OUTPUT_FIREWALL_BLOCK_THRESHOLD=3

RANDOM_SEED=42
DATASET_VERSION=v1
